[35.184, "o", " \u001b[1mkickback doctor\u001b[0m\r\r\n \u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\r\n  crypto backend  cryptography\r\r\n  config          /Users/gabe/.config/kickback/config.json\r\r\n  network         \u001b[32mon\u001b[0m\r\r\n  editor:Code    \u001b[32mvalid 58m\u001b[0m  \u001b[2mrunning\u001b[0m\r\r\n  backend         \u001b[32mreachable\u001b[0m\r\r\n  extension       \u001b[32mkickbacksai.kickbacks-ai-0.3.177\u001b[0m\r\r\n  job:sampler     \u001b[32mok\u001b[0m\r\r\n  job:notifications \u001b[32mok\u001b[0m\r\r\n \u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\r\n\u001b[2m  `kickback about` explains each item and what could change it.\u001b[0m\r\r\n"]
